# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_copyright_saas
DB_USERNAME=copyright
DB_PASSWORD=your_strong_password

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== Elasticsearch 配置 ====================
ES_URIS=http://localhost:9200

# ==================== MinIO 对象存储配置 ====================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=copyright-saas

# ==================== XXL-Job 调度中心配置 ====================
XXL_JOB_ADMIN=http://localhost:8080/xxl-job-admin

# ==================== JWT Token 密钥 ====================
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ==================== 邮件服务配置（预警通知） ====================
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=your_email@qq.com

# ==================== 短信服务配置（阿里云） ====================
SMS_ACCESS_KEY_ID=your_access_key_id
SMS_ACCESS_KEY_SECRET=your_access_key_secret
SMS_SIGN_NAME=您的签名名称
SMS_TEMPLATE_CODE=your_template_code

# ==================== 企业微信 webhook（可选） ====================
WECHAT_WORK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key

# ==================== 钉钉 webhook（可选） ====================
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token
